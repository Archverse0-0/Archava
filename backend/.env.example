LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Comma-separated browser origins allowed to request LiveKit tokens.
ALLOWED_ORIGINS=http://localhost:5173
TOKEN_RATE_LIMIT_PER_MINUTE=30

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore

# Optional integrations. Leave blank to disable.
N8N_MCP_SERVER_URL=

# Comma-separated allowlist of MCP tool names this deployment is authorised to
# expose to the concierge. An MCP server can offer payment, database-write,
# email-send and destructive actions; only the tools named here are registered,
# and nothing is registered when this is blank. Use exact tool names from the
# server's own catalogue.
N8N_MCP_ALLOWED_TOOLS=

TAVUS_API_KEY=your_tavus_api_key
FACE_ID=your_tavus_face_id
PAL_ID=
TAVUS_ENABLED=true

# Optional physical email delivery (generic SMTP, any provider).
# Leave SMTP_HOST blank to disable. SMTP_USE_SSL=true uses implicit TLS on
# connect (port 465); set it to false for STARTTLS on the submission port
# (usually 587).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_SSL=true
