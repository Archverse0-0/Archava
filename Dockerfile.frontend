# Pinned to the same major Node version as CI and .nvmrc (24). The jsdom /
# testing-library versions in this project declare engines of
# ^22.22.2 || ^24.15.0 || >=26.0.0, so an older base image cannot run the test
# suite at all.
FROM node:24-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps
COPY . .

# Vite substitutes every `import.meta.env.VITE_*` reference with a LITERAL
# STRING while `npm run build` runs. Setting these as container runtime
# environment variables afterwards cannot change the already-built bundle, so
# they must arrive as build arguments from docker-compose (or `--build-arg`).
#
# VITE_LIVEKIT_URL  - LiveKit WebSocket endpoint the browser connects to.
# VITE_API_BASE_URL - Origin of the token server. Leave empty to use the
#                     same-origin `/api/getToken` path, which nginx proxies to
#                     the `token-server` service below. It only needs a value
#                     when the frontend is served from a different origin than
#                     the token server (for example a Vercel deployment, where
#                     no reverse proxy exists). See DEPLOY_GUIDE.md.
ARG VITE_LIVEKIT_URL
ENV VITE_LIVEKIT_URL=${VITE_LIVEKIT_URL}
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:alpine AS production
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
